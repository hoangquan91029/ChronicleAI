# ==============================================================================
# ChronicleAI Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Metadata
APP_NAME=ChronicleAI
VERSION=1.0.0
DEBUG=false

# Backend Server
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend Next.js Client
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# LLM Provider Configuration
# Options: 'auto' (detects API keys or falls back to offline engine), 'gemini', 'openai', 'offline'
LLM_PROVIDER=auto

# Optional Remote AI Provider Keys (Leave blank to use hermetic offline rule engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Document Chunking & Text Extraction
CHUNK_SIZE=900
CHUNK_OVERLAP=100
MIN_CHUNK_CHARS=50
SCANNED_THRESHOLD_CHARS_PER_PAGE=30

# Vector Search & Retrieval
TOP_K_DEFAULT=5
SIMILARITY_THRESHOLD=0.15

# Security & CORS Origins (comma-separated or wildcard)
CORS_ORIGINS=*

# Video Rendering & Voiceover Narration
ENABLE_TTS=false
AUDIO_MODE=ambient
